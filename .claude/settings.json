{
  "permissions": {
    "ask": [
      "Bash(python team/bin/send.py:*)",
      "Bash(python3 team/bin/send.py:*)",
      "Bash(py team/bin/send.py:*)"
    ],
    "deny": [
      "Bash(curl * -X POST *api/requests*)",
      "Bash(curl *api/requests* -X POST*)",
      "Bash(curl * -F kind=*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-send.sh\"" }
        ]
      }
    ]
  }
}
