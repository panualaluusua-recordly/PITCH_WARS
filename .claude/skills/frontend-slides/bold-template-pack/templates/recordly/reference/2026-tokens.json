  "rules": {
    "do": [
      "one lime element per slide",
      "70% line height across a heading's own wrapped lines",
      "a heading is one colour (lime); hierarchy comes from the off-white Light lead line beneath it",
      "left-align body copy and lists; centre only cover titles and chip labels",
      "hold the 0.5in margin and the 5.1in floor",
      "0.75pt on every rule and outline",
      "greyscale photography, darkened to match the text over it",
      "only the sanctioned type sizes: 54/34/24/22/20/16/14/12/10/9/8"
    ],
    "dont": [
      "tint the lime, add a second accent, or promote #0097A7 to a brand colour",
      "round rectangle corners",
      "set #666666 as body text on dark",
      "rebuild the logo, tagline or corner tab as shapes",
      "set headings in anything but Montserrat Black",
      "replace the background noise with a flat fill",
      "place content in the bottom 0.5in",
      "split a heading across a lime line and an off-white line — that is the type specimen's labelling, not a brand pattern"
    ]
  },
  "known_inconsistencies": [
    "two left margins: CUSTOM_* layouts at 0.495in, BLANK_* diagram layouts at 0.38in",
    "eyebrow y drifts between 0.01 and 0.28 across layouts",
    "heading weight split: Black on the specimen slide, ExtraBold on the reference layout",
    "stray #E46962 in layout 3 and a stray Manrope declaration in layout 48",
    "all 51 layouts carry auto-generated CUSTOM_*/BLANK_* names",
    "theme major/minor fonts still Arial while every style overrides to Montserrat",
    "brand reference layouts sit in the same list as presentation layouts"
  ]
